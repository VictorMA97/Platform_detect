# Variables de entorno del laboratorio TFM. Todas las credenciales son
# explicitamente ficticias y estan confinadas a la red Docker del laboratorio.
# docker compose carga este fichero automaticamente por estar en la raiz del
# proyecto, junto a docker-compose.yml.

# --- Version del stack Wazuh ---
# Afecta a las imagenes de wazuh.manager / wazuh.indexer.
WAZUH_STACK_VERSION=4.14.6
# Version del paquete .deb del agente (incluye revision de paquete, formato
# distinto al de las imagenes: X.Y.Z-N).
WAZUH_AGENT_PACKAGE_VERSION=4.14.6-1

# --- Credenciales del indexer (OpenSearch) ---
# ADVERTENCIA: el usuario 'admin' tiene un hash bcrypt FIJO en
# config/wazuh_indexer/internal_users.yml. Cambiar INDEXER_PASSWORD aqui sin
# regenerar ese hash (plugin/tools/hash.sh dentro de la imagen del indexer)
# rompe la autenticacion entre manager e indexer.
INDEXER_USERNAME=admin
INDEXER_PASSWORD=SecretPassword

# --- Credenciales de la API REST de Wazuh (puerto 55000) ---
# Libres: el manager crea este usuario en el primer arranque a partir de
# estas variables; no dependen de ningun hash preexistente.
API_USERNAME=wazuh-wui
API_PASSWORD=MyS3cr37P450r.*-

# --- Usuario de prueba en el servidor victima (servicio 'victim') ---
# Ficticio, existe solo dentro de este laboratorio.
LAB_USER=corpuser
LAB_PASSWORD=Lab-Ficticio-2026!
LAB_ALLOW_SUDO=yes

# --- Identidad del agente ante el manager ---
WAZUH_AGENT_NAME=agent-poc-1
WAZUH_AGENT_GROUP=default

# --- TheHive + Cortex (gestion de incidentes y analisis de artefactos) ---
THEHIVE_VERSION=4.1.24-1
CORTEX_VERSION=3.2.1-1
CORTEX_ELASTICSEARCH_VERSION=7.11.1
# Secretos internos de Play Framework (firman sesiones/cookies). No son
# credenciales de acceso: los usuarios de TheHive/Cortex son admin@thehive.local
# / secret, fijados por el propio proyecto TheHive como valor por defecto de
# laboratorio (ver README).
# Al menos 32 caracteres (256 bits): Play Framework exige esa entropia minima
# para firmar JWT con HS256, o el servicio no arranca.
THEHIVE_SECRET=Lab-TheHive-Secret-2026-Ficticio-POC
CORTEX_SECRET=Lab-Cortex-Secret-2026-Ficticio-POC

# Credenciales de Cortex creadas por el bootstrap automatico (ver
# thehive-cortex/bootstrap/create_cortex_org.sh): ficticias, confinadas a la
# red del laboratorio. CORTEX_ADMIN_* es el superadmin del sistema (solo
# gestiona la instancia, no analiza artefactos); CORTEX_ANALYST_* es el
# usuario real que TheHive usa para hablar con Cortex (organizacion TFM).
CORTEX_ADMIN_USER=cortex-admin@tfm-lab.local
CORTEX_ADMIN_PASSWORD=Lab-Cortex-Admin-2026!
CORTEX_ANALYST_USER=analyst@tfm-lab.local
CORTEX_ANALYST_PASSWORD=Lab-Cortex-Analyst-2026!
